{
  "name": "sedim",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/cli/src/**/*.ts": [
      "biome check --write --no-errors-on-unmatched",
      "vitest run --reporter=verbose --project=cli --passWithNoTests"
    ],
    "packages/cli/tests/**/*.ts": [
      "biome check --write --no-errors-on-unmatched",
      "vitest run --reporter=verbose --project=cli --passWithNoTests"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "tsup": "^8.5.1",
    "turbo": "2.9.12",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@9.0.0"
}

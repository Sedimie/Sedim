{
  "name": "@sedim/cli",
  "version": "1.0.0",
  "description": "Premium codegen CLI — stamp production-ready feature modules into your project",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "sedim": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && mkdir -p dist/fonts && cp node_modules/figlet/fonts/Block.flf dist/fonts/ && mkdir -p fonts && cp node_modules/figlet/fonts/Block.flf fonts/",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cli",
    "codegen",
    "auth",
    "typescript",
    "nodejs",
    "drizzle",
    "prisma",
    "express",
    "nextjs",
    "hono"
  ],
  "author": "Sedim <hello@sedim.dev>",
  "license": "MIT",
  "files": ["dist", "fonts"],
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.2",
    "figlet": "^1.11.0",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
